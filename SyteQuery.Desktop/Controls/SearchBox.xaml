<UserControl x:Class="SyteQuery.Desktop.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SyteQuery.Desktop.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Bare text surface: the Fluent TextBox template draws its own border/background and
             focus effects, which would double up inside this control's own frame. -->
        <ControlTemplate x:Key="BareTextBoxTemplate" TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>

        <ControlTemplate x:Key="ClearButtonTemplate" TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Width="22" Height="22" Margin="0,0,3,0">
                <Path Data="M5,5 L13,13 M13,5 L5,13" Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <!-- The frame is what makes it read as a search field: a magnifier on the left, hint text
         while empty, a clear button once there's text, and an accent underline when focused. -->
    <Border x:Name="Frame" CornerRadius="5" BorderThickness="1" MinHeight="32"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Root}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Width="15" Height="15" Margin="9,0,6,0" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Data="M10.5,3.5 A7,7 0 1 0 10.5,17.5 A7,7 0 1 0 10.5,3.5 Z M15.7,15.7 L21,21"
                          Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>

            <TextBlock Grid.Column="1" x:Name="HintText" IsHitTestVisible="False" VerticalAlignment="Center"
                       Text="{Binding Placeholder, ElementName=Root}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBox Grid.Column="1" x:Name="Input" Template="{StaticResource BareTextBoxTemplate}"
                     Background="Transparent" BorderThickness="0" Padding="0,6"
                     VerticalContentAlignment="Center"
                     Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="OnInputKeyDown" />

            <Button Grid.Column="2" Template="{StaticResource ClearButtonTemplate}" Click="OnClearClick"
                    ToolTip="Clear search" Focusable="False" Cursor="Arrow">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Input, Converter={x:Static local:NotEmptyConverter.Instance}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
