<Window x:Class="SyteQuery.Desktop.Environments.EnvironmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Environments" Height="380" Width="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="Grid" Grid.Row="0"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  MouseDoubleClick="OnGridDoubleClick"
                  SelectionChanged="OnGridSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" />
                <DataGridTextColumn Header="Config" Binding="{Binding Config}" Width="100" />
                <DataGridTextColumn Header="IDO" Binding="{Binding IdoName}" Width="140" />
                <DataGridTextColumn Header="Username" Binding="{Binding User}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AddButton" Content="Add..." Width="80" Margin="0,0,8,0" Click="OnAddClick" />
            <Button x:Name="EditButton" Content="Edit..." Width="80" Margin="0,0,8,0" Click="OnEditClick" IsEnabled="False" />
            <Button x:Name="RemoveButton" Content="Remove" Width="80" Margin="0,0,16,0" Click="OnRemoveClick" IsEnabled="False" />
            <Button x:Name="CloseButton" Content="Close" Width="80" Click="OnCloseClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
