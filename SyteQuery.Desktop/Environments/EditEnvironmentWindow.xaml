<Window x:Class="SyteQuery.Desktop.Environments.EditEnvironmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Environment" Height="420" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,4" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="URL" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="UrlBox" Margin="0,4"
                 ToolTip="Scheme and host only, e.g. https://csi10X.erpsl.inforcloudsuite.com - anything after the host is ignored" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Config" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ConfigBox" Margin="0,4" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="IDO name" VerticalAlignment="Center" Margin="0,4" />
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,4">
            <TextBox x:Name="IdoNameBox"
                     ToolTip="The name of the IDO you created in SyteLine for SyteQuery to run queries through. Its method must be ExecuteQuery. See SyteQuery.IDO/README.md in the SyteQuery repository for how to create it." />
            <TextBlock Text="e.g. ue_QueryTool" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=IdoNameBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Username" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="UsernameBox" Margin="0,4" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,4" />
        <PasswordBox Grid.Row="5" Grid.Column="1" x:Name="PasswordBox" Margin="0,4"
                     ToolTip="Leave blank to keep the current password" />

        <TextBlock Grid.Row="6" Grid.Column="1" Text="(leave blank to keep the current password)"
                   FontStyle="Italic" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />

        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ErrorText" Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Top" />

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="SaveButton" Content="Save" Width="80" Margin="0,0,8,0" Click="OnSaveClick" IsDefault="True" />
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
