<Window x:Class="SyteQuery.Desktop.Compare.CompareStoredProcedureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SyteQuery.Desktop.Compare"
        Title="Compare Stored Procedure" Height="720" Width="1180"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Translucent tints so the same colors read on both light and dark backgrounds. -->
        <SolidColorBrush x:Key="RemovedBrush" Color="#40FF5A5A" />
        <SolidColorBrush x:Key="AddedBrush" Color="#4036B37E" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Environment A" Style="{StaticResource SecondaryText}" Margin="0,0,0,3" />
                <ComboBox x:Name="EnvABox" DisplayMemberPath="Name" SelectedValuePath="Id" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Environment B" Style="{StaticResource SecondaryText}" Margin="0,0,0,3" />
                <ComboBox x:Name="EnvBBox" DisplayMemberPath="Name" SelectedValuePath="Id" />
            </StackPanel>
            <Button x:Name="CompareButton" Grid.Column="3" Content="Compare" Margin="16,0,0,0" Padding="18,6"
                    VerticalAlignment="Bottom" Click="OnCompareClick" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <CheckBox x:Name="IgnoreWhitespaceBox" Content="Ignore whitespace-only changes" IsChecked="True" />
            <TextBlock x:Name="ErrorText" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            <TextBlock x:Name="SummaryText" Margin="0,6,0,0" Style="{StaticResource SecondaryText}" />
        </StackPanel>

        <ListBox x:Name="DiffList" Grid.Row="3" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 HorizontalContentAlignment="Stretch" BorderThickness="1"
                 BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:DiffRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Grid.ColumnSpan="2" x:Name="LeftBg" Background="Transparent" />
                        <Border Grid.Column="3" Grid.ColumnSpan="2" x:Name="RightBg" Background="Transparent" />
                        <Border Grid.Column="2" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <TextBlock Grid.Column="0" Text="{Binding LeftLineNumber}" HorizontalAlignment="Right" Margin="0,1,8,1"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding LeftText}" Margin="2,1" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding RightLineNumber}" HorizontalAlignment="Right" Margin="0,1,8,1"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="{Binding RightText}" Margin="2,1" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="LeftOnly">
                            <Setter TargetName="LeftBg" Property="Background" Value="{StaticResource RemovedBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="RightOnly">
                            <Setter TargetName="RightBg" Property="Background" Value="{StaticResource AddedBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="4" Content="Close" Width="90" HorizontalAlignment="Right" Margin="0,12,0,0"
                IsCancel="True" Click="OnCloseClick" />
    </Grid>
</Window>
