<UserControl x:Class="SyteQuery.Desktop.Snippets.SnippetsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SyteQuery.Desktop.Snippets"
             xmlns:controls="clr-namespace:SyteQuery.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="240">
    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Margin="4">
            <controls:SearchBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                               Placeholder="Search snippets..." Margin="0,0,0,6" />
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="✕" Width="22" Margin="4,0,0,0"
                        Click="OnClearCategoryFilterClick" ToolTip="Clear category filter" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}"
                          ToolTip="Filter by category" />
            </DockPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4" HorizontalAlignment="Right">
            <Button Content="New..." Click="OnNewClick" Margin="0,0,4,0" Padding="6,2" />
            <Button Content="Edit..." Click="OnEditClick" Margin="0,0,4,0" Padding="6,2" />
            <Button Content="Delete" Click="OnDeleteClick" Margin="0,0,4,0" Padding="6,2" />
            <Button Content="Load" Click="OnLoadClick" Padding="6,2" FontWeight="Bold" />
        </StackPanel>

        <ListBox x:Name="List" ItemsSource="{Binding Snippets}"
                 ItemContainerStyle="{DynamicResource StretchListBoxItem}"
                 BorderThickness="0" Margin="0,0,0,4"
                 MouseDoubleClick="OnListDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,2">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding Category, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                        <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding Description, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</UserControl>
